{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"
  ],
  "mcp": {
    "team-atlassian": {
      "type": "local",
      "command": ["uvx", "--native-tls", "mcp-atlassian@0.23.1"],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "CONFLUENCE_URL": "{env:CONFLUENCE_URL}",
        "CONFLUENCE_USERNAME": "{env:CONFLUENCE_USERNAME}",
        "CONFLUENCE_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
      },
      "timeout": 600000,
      "enabled": false
    },
    "team-github": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e", "GITHUB_HOST",
        "ghcr.io/github/github-mcp-server:v1.14.0"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "GITHUB_HOST": "{env:GITHUB_HOST}"
      },
      "timeout": 600000,
      "enabled": false
    },
    "team-copilot": {
      "type": "remote",
      "url": "https://mcp.svc.cloud.microsoft/enterprise",
      "timeout": 600000,
      "enabled": false
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": {
      "*": "ask"
    }
  },
  "formatter": false,
  "lsp": true
}
